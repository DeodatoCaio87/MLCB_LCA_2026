import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score


dados = {
    "frase": [
        "Quero comprar uma passagem para São Paulo",
        "Gostaria de reservar um voo para o Rio de Janeiro",
        "Preciso comprar uma passagem de avião",
        "Quero fazer uma reserva de passagem",
        
        "Quero cancelar minha reserva",
        "Preciso cancelar meu voo",
        "Como faço para cancelar uma passagem?",
        "Gostaria de cancelar minha viagem",
        
        "Quero falar com um atendente",
        "Preciso falar com uma pessoa",
        "Pode me encaminhar para um atendente?",
        "Quero atendimento humano"
    ],

    "intencao": [
        "comprar_passagem",
        "comprar_passagem",
        "comprar_passagem",
        "comprar_passagem",

        "cancelar_reserva",
        "cancelar_reserva",
        "cancelar_reserva",
        "cancelar_reserva",

        "falar_atendente",
        "falar_atendente",
        "falar_atendente",
        "falar_atendente"
    ]
}

df = pd.DataFrame(dados)

print("Dataset:")
print(df)



X = df["frase"]
y = df["intencao"]

X_treino, X_teste, y_treino, y_teste = train_test_split(
    X,
    y,
    test_size=0.25,
    random_state=42,
    stratify=y
)




vetorizador = TfidfVectorizer()

X_treino_vetorizado = vetorizador.fit_transform(X_treino)
X_teste_vetorizado = vetorizador.transform(X_teste)




modelo = LogisticRegression(max_iter=1000)




modelo.fit(X_treino_vetorizado, y_treino)




previsoes_teste = modelo.predict(X_teste_vetorizado)

acuracia = accuracy_score(y_teste, previsoes_teste)

print("\nAcurácia do modelo:", acuracia)



frases_ineditas = [
    "Gostaria de adquirir um bilhete para minha viagem",
    "Não quero mais minha reserva de voo",
    "Preciso conversar com alguém do atendimento"
]

frases_vetorizadas = vetorizador.transform(frases_ineditas)

previsoes = modelo.predict(frases_vetorizadas)


print("\nPredições das frases inéditas:")

for frase, intencao in zip(frases_ineditas, previsoes):
    print(f"Frase: {frase}")
    print(f"Intenção prevista: {intencao}")
    print("-" * 50)
